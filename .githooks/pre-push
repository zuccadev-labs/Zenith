#!/usr/bin/env bash
# Zenith pre-push gate: the fast checks of the CI, before anything reaches GitHub.
# The organisation's free plan has no branch protection for private repositories, and GitHub only runs
# the CI on manual dispatch there, so this is the gate. Enable it once (each developer, by choice):
#   git config core.hooksPath .githooks && chmod +x .githooks/pre-push
# Skip it (emergencies only):  ZENITH_SKIP_PREPUSH=1 git push
set -euo pipefail
[[ "${ZENITH_SKIP_PREPUSH:-}" == "1" ]] && { echo "pre-push: skipped (ZENITH_SKIP_PREPUSH=1)"; exit 0; }

root="$(git rev-parse --show-toplevel)"
export TMPDIR="${ZENITH_TEST_TMP:-$HOME/.cache/zenith-tests-tmp}"
mkdir -p "$TMPDIR"
step() { printf '\n▶ %s\n' "$1"; }

step "engine and cli: format"
(cd "$root/zenith-backend" && deno fmt --check src/ tests/)
(cd "$root/zenith-cli" && deno fmt --check)
step "engine: lint"
(cd "$root/zenith-backend" && deno lint src/)
step "engine: typecheck (frozen lock)"
(cd "$root/zenith-backend" && deno check --frozen src/mod.ts)
step "engine: unit tests (frozen lock)"
(cd "$root/zenith-backend" && deno test --allow-all --no-check --unstable-kv --frozen --quiet tests/unit/)
step "cli: typecheck (frozen lock)"
(cd "$root/zenith-cli" && deno check --frozen zen.ts mod.ts)
if command -v docker >/dev/null 2>&1; then
  step "secrets: gitleaks (whole history)"
  docker run --rm -v "$root:/repo:ro" zricethezav/gitleaks:v8.30.1 git /repo --no-banner --redact \
    --gitleaks-ignore-path /repo/.gitleaksignore
fi
printf "\n✅ pre-push: all checks passed. tools/ship.sh pushes and waits for the full CI.\n"
