# -------------------------------------------------------------------
#  Zenith Lab Infrastructure -- Variables de Entorno del Laboratorio
#
#  COPIA ESTE ARCHIVO COMO .env ANTES DE LEVANTAR LOS SERVICIOS
#  NUNCA subas el .env al repositorio (esta en .gitignore)
# -------------------------------------------------------------------

# -- Zenith Core ----------------------------------------------------
ZENITH_APP_ID=zenith-dev
ZENITH_MASTER_KEY=changeme_masterkey_lab
ZENITH_PORT=1337
# Claves HMAC de URLs firmadas y auditoría (ADR-016). Genera cada una con: openssl rand -hex 32
FILE_SIGNING_KEY=
AUDIT_SIGNING_KEY=
# Cifrado de los secretos de webhooks y firma de los Cloud Code Hooks (ADR-017)
WEBHOOK_SECRETS_KEY=
# whsec_ + base64 de 32 bytes: deno eval 'console.log("whsec_"+btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32)))))'
ZENITH_HOOKS_SECRET=

# -- Base de Datos Principal (PostgreSQL) ---------------------------
PG_USER=zenith
PG_PASSWORD=zenith_postgres_password_change_me
PG_DB=zenith_db

# -- MongoDB --------------------------------------------------------
MONGO_URI=mongodb://zenith-mongo:27017/zenith_dev
MONGO_RS=rs0

# -- ScyllaDB (Auth / Sessions) ------------------------------------
SCYLLA_KEYSPACE=zenith_auth

# -- RustFS / S3-Compatible Storage --------------------------------
RUSTFS_ACCESS_KEY=zenith_admin
RUSTFS_SECRET_KEY=zenith_rustfs_secret_change_me
RUSTFS_BUCKET=zenith-storage

# -- IAM - Zitadel -------------------------------------------------
# ZITADEL_MASTERKEY debe tener EXACTAMENTE 32 bytes
ZITADEL_DB_PASSWORD=zitadel_password_change_me
ZITADEL_MASTERKEY=my-very-secure-32-byte-key-here!
ZITADEL_ADMIN_PASSWORD=Admin1234!

# -- IAM - Keycloak ------------------------------------------------
KEYCLOAK_DB_PASSWORD=keycloak_password_change_me
KEYCLOAK_ADMIN_PASSWORD=Admin1234!

# -- Correo - Postal -----------------------------------------------
POSTAL_DB_PASSWORD=postal_db_password_change_me
POSTAL_RABBITMQ_PASSWORD=postal_rmq_password_change_me
POSTAL_ADMIN_EMAIL=admin@zenith.local
POSTAL_ADMIN_PASSWORD=PostalAdmin1234!

# -- Novu (Push Notifications / Webhooks) --------------------------
# NOVU_STORE_ENCRYPTION_KEY EXACTAMENTE 32 chars (AES-256)
NOVU_API_KEY=changeme_novu_api_key
NOVU_JWT_SECRET=zenith_novu_jwt_secret_change_32c
NOVU_STORE_ENCRYPTION_KEY=zenith_novu_enc_key_32chars_here

# -- OpenTelemetry Collector ---------------------------------------
OTEL_SERVICE_NAME=zenith-backend

# -- DNS Local (dnsmasq) ------------------------------------------
# IP del host Docker para que *.zenith.local resuelva a la VM/host
# En VM Proxmox: IP que asigne DHCP a la VM
# En local (Windows/Linux): 127.0.0.1 o IP del bridge Docker
# IP de la VM Zenith en la red LAN (la que le asigne DHCP Proxmox)
ZENITH_VM_IP=192.168.14.50

# (obsoleto - reemplazado por ZENITH_VM_IP)
# ZENITH_HOST_IP=127.0.0.1

# -- Proxmox (solo para Packer/Pulumi, NO para docker compose) -----
# PROXMOX_API_URL=http://192.168.14.44:8006/api2/json
# PROXMOX_API_TOKEN_ID=root@pam!packer
# PROXMOX_API_TOKEN_SECRET=<tu-token>

# ====================================================================
# UBB — Universal Business Backend (Zenith v2)
# ====================================================================

# -- SurrealDB (Multi-Model DB: SQL + Graph + Document) -------------
# Puerto lab: 58000 | CLI: surreal sql --conn http://192.168.14.50:58000 --user root --pass ${SURREAL_PASS}
SURREAL_PASS=zenithlab
SURREAL_NAMESPACE=zenith
SURREAL_DATABASE=production

# -- Qdrant (Vector Database para RAG e IoT semántico) --------------
# Puerto lab: 56333 (REST+Dashboard) | 56334 (gRPC)
# Dashboard: http://192.168.14.50:56333/dashboard
QDRANT_API_KEY=zenithqdrant

# -- EMQX (Enterprise MQTT Broker para IoT) -------------------------
# Puerto MQTT/TCP: 51883 | MQTT/WS: 58083 | Dashboard: 58080
# Dashboard: http://192.168.14.50:58080  admin / ${EMQX_ADMIN_PASS}
EMQX_ADMIN_PASS=zenithemqx
MQTT_NAMESPACE=zenith

# -- Ollama (LLM local para embeddings y agentes) -------------------
# Instalar: https://ollama.ai
# Modelos recomendados: nomic-embed-text (embeddings), llama3.1 (agentes)
# Default: http://localhost:11434
OLLAMA_URL=http://192.168.14.50:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_AGENT_MODEL=llama3.1

# -- Zenith UBB Feature Flags (activar en config del servidor) ------
# Cada flag activa un Trait en el boot de Zenith.
# Configurar en el objeto config.features al crear la app:
ZENITH_FEATURE_IOT=true
ZENITH_FEATURE_VECTORDB=true
ZENITH_FEATURE_AGENTS=true
ZENITH_FEATURE_TIMESERIES=true
ZENITH_FEATURE_WORKFLOW=true
ZENITH_FEATURE_MULTI_TENANT=false
ZENITH_FEATURE_COMPLIANCE=false

# -- ScyllaDB Time-Series (ya en infra, puerto 53042) ---------------
# Keyspace usado por TimeSeriesTrait
SCYLLA_TS_KEYSPACE=zenith
SCYLLA_TS_TTL_DAYS=90

# -- LLM API Keys (opcional si usas proveedores externos) ----------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# LuxDB (Redis-compatible, used by Novu and by Zenith as cacheURI: redis://:<LUX_PASSWORD>@host:53079)
LUX_PASSWORD=
